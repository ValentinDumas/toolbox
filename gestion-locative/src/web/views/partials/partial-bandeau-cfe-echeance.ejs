<%#
  Partial — Bandeau échéance CFE J-30 (UI-SPEC §S10, Plan 06-07 / D-CFE6.5).

  Props :
    - alerte : AlerteCfe { joursRestants, dateEcheancePaiement, statutCfe, millesime, bienId }

  3 variantes visuelles selon `joursRestants` :
    - J-30 à J-8 : warning (bord gauche orange).
    - J-7 à J-0  : warning forte (fond orange clair + bord plus marqué).
    - J+1 et plus : destructive (bord rouge — échéance dépassée).

  Lien externe vers impots.gouv.fr avec `target="_blank" rel="noopener noreferrer"` (V9 ASVS).

  Helpers attendus (preHandler) : formatDate.
%>
<%
  const j = alerte.joursRestants;
  let libelleEtat;
  if (j < 0) {
    libelleEtat = "Échéance dépassée depuis " + Math.abs(j) + " jour" + (Math.abs(j) > 1 ? 's' : '');
  } else if (j === 0) {
    libelleEtat = "Échéance aujourd'hui";
  } else if (j <= 7) {
    libelleEtat = "Échéance dans " + j + " jour" + (j > 1 ? 's' : '');
  } else {
    libelleEtat = "Échéance dans " + j + " jours";
  }

  const titre = "CFE " + alerte.millesime + " — " + libelleEtat + ".";
  const texteEcheance = "Échéance le " + formatDate(alerte.dateEcheancePaiement) + ".";
  const ariaLabel = "Alerte CFE " + alerte.millesime;
  const urlCfe = "/biens/" + alerte.bienId + "/cfe/" + alerte.declarationCfeId + "/editer";
  const blocActions = `<p>
    <a
      href="https://www.impots.gouv.fr/professionnel/cotisation-fonciere-des-entreprises-cfe"
      target="_blank"
      rel="noopener noreferrer"
      role="button"
    >Régler la CFE sur impots.gouv.fr</a>
    &nbsp;
    <a href="${urlCfe}">
      Mettre à jour le statut
    </a>
  </p>`;
%>
<%- include('_bandeau-cfe-corps', { joursRestants: alerte.joursRestants, ariaLabel, titre, texteEcheance, blocActions, avecIcone: false, icone: '' }) -%>
