<%#
  Partial — Bandeau d'alerte unifié polymorphe (Phase 7 / DAS-01 / D-AL-05).

  Props :
    - alerte : Alerte { type, joursRestants, dateEcheance, libelle, urlAction, source }
    - inline (optionnel) : si true, variante compact sans lien d'action
      (utilisé par la table /baux/indexations — plan 07-06)

  3 variantes visuelles selon `joursRestants` (identique partial-bandeau-cfe-echeance.ejs) :
    - destructive  : joursRestants <= 0  → role="alert" aria-live="assertive"
    - warning-fort : 1 <= joursRestants <= 7 → role="alert" aria-live="assertive"
    - warning      : joursRestants >= 8  → role="status" aria-live="polite"

  WCAG 1.4.1 : couleur jamais seule — doublée par libellé textuel + icône aria-hidden + libellé type.

  Helpers attendus (injectés via preHandler global main.ts) :
    - formatDate(date)            → date au format fr-FR
    - formaterAlerteUrgence(alerte) → libellé textuel WCAG
    - iconeTypeAlerte(type)       → caractère Unicode aria-hidden sobre
    - libelleTypeAlerte(alerte)   → libellé français du type
%>
<%
  const libelleUrgence = formaterAlerteUrgence(alerte);
  const libelleType    = libelleTypeAlerte(alerte);
  const icone          = iconeTypeAlerte(alerte.type);
  const titre          = libelleType + " — " + libelleUrgence + ".";
  const texteEcheance  = "Échéance le " + formatDate(alerte.dateEcheance) + ".";
  const ariaLabel      = "Alerte " + libelleType;

  let blocActions = null;
  if (!locals.inline) {
    // CR-02 : urlAction est concaténé dans du HTML brut (blocActions) rendu
    // sans échappement — on l'échappe ici (comme le faisait l'ancien rendu
    // échappé) pour préserver la défense en profondeur XSS. Pour une URL
    // interne sûre, la sortie reste identique.
    const escAttr = (s) => String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
    const url = escAttr(alerte.urlAction);
    let lienAction = '';
    if (alerte.type === 'cfe') {
      lienAction = '<a href="https://www.impots.gouv.fr/professionnel/cotisation-fonciere-des-entreprises-cfe"\n           target="_blank" rel="noopener noreferrer" role="button">\n          Régler la CFE sur impots.gouv.fr\n        </a>\n        &nbsp;\n        <a href="' + url + '">Mettre à jour le statut</a>';
    } else if (alerte.type === 'irl') {
      lienAction = '<a href="' + url + '" role="button">Lancer la révision IRL</a>';
    } else if (alerte.type === 'diagnostic') {
      lienAction = '<a href="' + url + '" role="button">Voir le diagnostic</a>';
    } else if (alerte.type === 'fin_bail') {
      lienAction = '<a href="' + url + '" role="button">Voir le bail</a>';
    }
    if (lienAction) {
      blocActions = '<p>\n        ' + lienAction + '\n      </p>';
    }
  }
%>
<%- include('_bandeau-cfe-corps', { joursRestants: alerte.joursRestants, ariaLabel, titre, texteEcheance, blocActions, avecIcone: true, icone }) -%>
